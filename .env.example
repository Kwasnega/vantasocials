# ─── Supabase ───────────────────────────────────────────────────────────────
# Public keys (safe to expose in the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase service role key (never expose this to the client)
SUPABASE_SERVICE_ROLE_KEY=

# ─── Site URL ────────────────────────────────────────────────────────────────
# Full URL of your deployed site, e.g. https://vantasocials.com
# Used for Paystack callback redirects and wallet deposit callbacks
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# ─── Paystack ────────────────────────────────────────────────────────────────
# Secret key from your Paystack dashboard (server-only)
PAYSTACK_SECRET_KEY=sk_test_your_key_here

# ─── Fulfillment Providers ───────────────────────────────────────────────────
# ReliableSMM API key (server-only)
RELIABLESMM_API_KEY=

# PanelFollows API key (server-only)
PANELFOLLOWS_API_KEY=

# ─── Live Fulfillment Gate ───────────────────────────────────────────────────
# Set to "true" to enable real order submission to providers.
# Leave blank or "false" during testing to keep all fulfillment in dry-run mode.
PANELS_LIVE_FULFILLMENT_ENABLED=false

# ─── Cron / Internal API Security ────────────────────────────────────────────
# Secret token used to authenticate internal cron job endpoints
# e.g. /api/internal/fulfillment/cron, /canary, /preflight, /reconcile
CRON_SECRET=

# ─── ReliableSMM R4 Test Harness (optional / dev only) ───────────────────────
# Internal secret for the R4 test route (/api/internal/reliablesmm/r4)
R4_INTERNAL_SECRET=

# Set to "true" only in development to enable R4 test mode
R4_TEST_MODE=false

# Optional: minimum milliseconds between ReliableSMM API requests (rate-limit tuning)
# Defaults to a safe value if not set
RELIABLESMM_MIN_REQUEST_INTERVAL_MS=
